; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since the parameters are simple, this works well.

config_version=5

[application]

config/name="Block Crash"
config/description="Block Crash - Casual Block Puzzle Game for Mobile"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.0470588, 0.0823529, 0.176471, 1)
boot_splash/image="res://assets/icon.png"
config/icon="res://assets/icon.png"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.09, 0.19, 1)
